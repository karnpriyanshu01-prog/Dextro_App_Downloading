# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://dextroplay.com

# Supabase (public-safe values only on the client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER prefix with NEXT_PUBLIC_, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Google AdSense publisher ID, e.g. pub-0000000000000000
ADSENSE_PUBLISHER_ID=

# Google Analytics measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Adsterra — banner (320x50 etc), social bar, popunder, and direct/smart
# link. bannerDomain is the rotating ad-network domain your invoke.js is
# served from (Adsterra dashboard gives you this per zone).
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_DOMAIN=
NEXT_PUBLIC_ADSTERRA_BANNER_468x60_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_728x90_KEY=
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_URL=
NEXT_PUBLIC_ADSTERRA_POPUNDER_URL=
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK=
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=
